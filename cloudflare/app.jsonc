// Ti Guigui FIT as a static, installable app (guest mode only: no API behind it).
// https gives the service worker, so the home-screen app works offline. Deploy from the repo root:
//   cd frontend && npm run build && cd .. && node scripts/catalogue/stage-media.mjs frontend/dist
//   npx wrangler deploy -c cloudflare/app.jsonc
{
  "name": "ti-guigui-fit",
  "compatibility_date": "2026-10-01",
  // "none": sw.js precaches index.html and fails its install if it gets redirected to "/"
  "assets": { "directory": "../frontend/dist", "html_handling": "none",
              "not_found_handling": "single-page-application" },
  "workers_dev": true
}
